# =============================================================================
# EGSA Space Academy — Admin Backend Production Configuration Template
# Copy to .env and configure secrets prior to deployment
# =============================================================================

NODE_ENV=production
PORT=5200

# Dedicated MongoDB Database
MONGO_URI=mongodb://127.0.0.1:27017/esa_academy

# JWT Configuration (Must be >= 32 characters in production)
JWT_SECRET=your_minimum_32_character_cryptographically_random_jwt_secret
JWT_EXPIRES_IN=7d

# CORS Allowed Origins
CLIENT_ORIGIN=https://academy.egsa.gov.eg,https://staging-academy.egsa.gov.eg

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Cross-Portal Integration
INTEGRATION_API_KEY=your_minimum_32_character_cryptographically_random_s2s_key
INSTRUCTOR_SERVICE_URL=http://127.0.0.1:5100

# Student Backend S2S Integration
# STUDENT_JWT_SECRET MUST match the JWT_SECRET (or JWT_ACCESS_SECRET) configured in EGSA-student/Back_End/.env
STUDENT_SERVICE_URL=http://127.0.0.1:5000
STUDENT_JWT_SECRET=your_minimum_32_character_cryptographically_random_student_jwt_secret

# Paymob Gateway
PAYMOB_API_KEY=configure_production_paymob_api_key
PAYMOB_HMAC_SECRET=configure_production_hmac_secret
PAYMOB_INTEGRATION_ID=configure_production_integration_id
PAYMOB_IFRAME_ID=configure_production_iframe_id
PAYMOB_BASE_URL=https://accept.paymob.com/api
PAYMOB_SANDBOX_SIMULATION=false
