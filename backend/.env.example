# =============================================================================
# EGSA Space Academy — Unified Backend Configuration Template
# =============================================================================

NODE_ENV=development
PORT=5000

# Client Origins for CORS (Comma-separated)
CLIENT_URL=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Database Connection URIs (Preserves existing role boundaries and data schemas)
# -----------------------------------------------------------------------------
STUDENT_MONGO_URI=mongodb://127.0.0.1:27017/egsa_academy
INSTRUCTOR_MONGO_URI=mongodb://127.0.0.1:27017/egsa_instructor
ADMIN_MONGO_URI=mongodb://127.0.0.1:27017/esa_academy

# -----------------------------------------------------------------------------
# Authentication & JWT Configuration
# -----------------------------------------------------------------------------
# Student Portal JWT
STUDENT_JWT_SECRET=egsa_student_jwt_secret_min_32_chars_long_placeholder
STUDENT_JWT_EXPIRES_IN=7d

# Instructor Portal JWT (Access + Rotated Refresh Hashes)
INSTRUCTOR_ACCESS_SECRET=egsa_instructor_access_secret_min_32_chars_placeholder
INSTRUCTOR_ACCESS_EXPIRES=15m
INSTRUCTOR_REFRESH_SECRET=egsa_instructor_refresh_secret_min_32_chars_placeholder
INSTRUCTOR_REFRESH_EXPIRES=7d

# Admin Portal JWT
ADMIN_JWT_SECRET=egsa_admin_jwt_secret_min_32_chars_long_placeholder
ADMIN_JWT_EXPIRES_IN=24h

# Service-to-Service / Integration API Key
INTEGRATION_API_KEY=egsa_internal_s2s_integration_key_placeholder

# -----------------------------------------------------------------------------
# Institutional SMTP Mailer Configuration
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Egyptian Space Agency Academy <no-reply@egsa.gov.eg>"

# -----------------------------------------------------------------------------
# Payment Gateway Configuration (Egyptian Paymob Accept)
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=DEVELOPMENT_MOCK
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_BASE_URL=https://accept.paymob.com/api
REFUND_DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
